{
  "llm": {
    "provider": "openai",
    "base_url": "https://your-endpoint.example.com/v1",
    "model": "",
    "long_context_model": "",
    "available_models": [],
    "models_fetched_at": null,
    "temperature": 0.3,
    "timeout_ms": 120000,
    "max_input_chars": 60000,
    "max_messages_per_call": 800,
    "max_image_chars_per_call": 300000,
    "custom_model": false,
    "custom_long_context_model": false
  },
  "link_preview": {
    "enabled": true,
    "ai_web_search": true,
    "max_links": 0,
    "timeout_ms": 8000,
    "max_bytes": 262144,
    "max_chars_per_link": 2000,
    "max_related_links": 3,
    "max_related_bytes": 98304,
    "max_related_chars": 800
  },
  "privacy": {
    "redact_phone": true,
    "redact_id_card": true,
    "redact_bank_card": true,
    "redact_email": false
  },
  "groups": {
    "whitelist": [],
    "overrides": [],
    "recent": []
  },
  "scheduler": {
    "enabled": false,
    "default_interval": "30m",
    "digest_window": "4h",
    "min_messages_per_digest": 30,
    "per_group": []
  },
  "output": {
    "dir": "./outputs/digests",
    "retention_days": 0,
    "filename_pattern": "{group}__{since}_{until}__{id8}.png"
  },
  "render": {
    "default_theme": "auto",
    "default_font_size": "normal",
    "width_px": 1080,
    "dpi_scale": 2
  },
  "web": {
    "host": "127.0.0.1",
    "port": 7788,
    "open_browser": true
  },
  "cache": {
    "decrypted_db_dir": "./outputs/.tmp/db",
    "keep_decrypted_copy": false
  },
  "wechat": {
    "manual_key_set": false
  },
  "logging": {
    "level": "info",
    "file": "./outputs/.tmp/wx-summary.log",
    "max_mb": 50
  }
}
